    <Compile Include="..\sensor-sidecar\Control\Lighting\HueLink.cs" Link="Control\Lighting\HueLink.cs" />
  </ItemGroup>

  <!-- Real-hardware sensor fixtures (see fixtures/README.md). Copied next to the
       test assembly so FixtureTests can discover them at runtime. -->
  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
