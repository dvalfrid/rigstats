<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SensorSidecar.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre749" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!--
    The production sidecar project is a self-contained single-file Exe, which a
    test library cannot ProjectReference (NETSDK1150). These files have no
    dependency beyond what's referenced above, so we compile them directly
    into the test assembly instead. This keeps the shipped sidecar build
    untouched.
  -->
  <ItemGroup>
    <Compile Include="..\sensor-sidecar\SensorReader.cs" Link="SensorReader.cs" />
    <Compile Include="..\sensor-sidecar\SensorWorker.cs" Link="SensorWorker.cs" />
    <Compile Include="..\sensor-sidecar\Control\ControlProtocol.cs" Link="Control\ControlProtocol.cs" />
    <Compile Include="..\sensor-sidecar\Control\SidecarLog.cs" Link="Control\SidecarLog.cs" />
    <Compile Include="..\sensor-sidecar\Control\CrashReport.cs" Link="Control\CrashReport.cs" />
    <Compile Include="..\sensor-sidecar\Control\HardwareHost.cs" Link="Control\HardwareHost.cs" />
    <Compile Include="..\sensor-sidecar\Control\ControlBroker.cs" Link="Control\ControlBroker.cs" />
    <Compile Include="..\sensor-sidecar\Control\SafetyGuard.cs" Link="Control\SafetyGuard.cs" />
    <Compile Include="..\sensor-sidecar\Control\ProfileStore.cs" Link="Control\ProfileStore.cs" />
    <Compile Include="..\sensor-sidecar\Control\DataDirectory.cs" Link="Control\DataDirectory.cs" />
    <Compile Include="..\sensor-sidecar\Control\PipeClientVerifier.cs" Link="Control\PipeClientVerifier.cs" />
    <Compile Include="..\sensor-sidecar\Control\ControlPipeWorker.cs" Link="Control\ControlPipeWorker.cs" />
    <Compile Include="..\sensor-sidecar\Control\RefusalLog.cs" Link="Control\RefusalLog.cs" />
    <Compile Include="..\sensor-sidecar\Control\FanWatchdog.cs" Link="Control\FanWatchdog.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\PowerPlanProvider.cs" Link="Control\Providers\PowerPlanProvider.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\FanProvider.cs" Link="Control\Providers\FanProvider.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\FanCurveEvaluator.cs" Link="Control\Providers\FanCurveEvaluator.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\FanCurveLoop.cs" Link="Control\Providers\FanCurveLoop.cs" />
    <Compile Include="..\sensor-sidecar\Control\ActiveProfileApplier.cs" Link="Control\ActiveProfileApplier.cs" />
    <Compile Include="..\sensor-sidecar\Control\BootCrashGuard.cs" Link="Control\BootCrashGuard.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\PawnIoModule.cs" Link="Control\Providers\PawnIoModule.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\RyzenSmu.cs" Link="Control\Providers\RyzenSmu.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\CpuLimitProvider.cs" Link="Control\Providers\CpuLimitProvider.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\AdlxGpuPower.cs" Link="Control\Providers\AdlxGpuPower.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\GpuPowerProvider.cs" Link="Control\Providers\GpuPowerProvider.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\NvmlGpuPower.cs" Link="Control\Providers\NvmlGpuPower.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\GpuPowerApis.cs" Link="Control\Providers\GpuPowerApis.cs" />
    <Compile Include="..\sensor-sidecar\Control\Providers\CurveOptimizerProvider.cs" Link="Control\Providers\CurveOptimizerProvider.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\HidDevice.cs" Link="Control\Lighting\HidDevice.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\AuraUsb.cs" Link="Control\Lighting\AuraUsb.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\AuraController.cs" Link="Control\Lighting\AuraController.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\LightingProvider.cs" Link="Control\Lighting\LightingProvider.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\SoftwareEffect.cs" Link="Control\Lighting\SoftwareEffect.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\AsusMonitorDevice.cs" Link="Control\Lighting\AsusMonitorDevice.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\LampArrayDevice.cs" Link="Control\Lighting\LampArrayDevice.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\OmniMouse.cs" Link="Control\Lighting\OmniMouse.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\LightingDiagnostics.cs" Link="Control\Lighting\LightingDiagnostics.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\AsusKeyboardDevice.cs" Link="Control\Lighting\AsusKeyboardDevice.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\AsusHeadsetDevice.cs" Link="Control\Lighting\AsusHeadsetDevice.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\LightingLog.cs" Link="Control\Lighting\LightingLog.cs" />
    <Compile Include="..\sensor-sidecar\Control\Lighting\LightingCatalog.cs" Link="Control\Lighting\LightingCatalog.cs" />
