# Claude Code: personal settings stay local (settings.local.json, worktrees, …).
# Shared: skills, hooks and the project settings.json (no machine-specific paths there).
# Use .claude/* (not .claude/) so these can be un-excluded
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json

node_modules/
website/images/
dist/
vendor/
.env
.vscode/
cargo-check-out.txt
debugLog/

# Rust build output
/target/

# .NET sidecar build output
sensor-sidecar/bin/
sensor-sidecar/obj/
sensor-sidecar/publish/
sensor-sidecar.Tests/bin/
sensor-sidecar.Tests/obj/
